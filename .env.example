# ─────────────────────────────────────────────────────────────
#  WIDOW · pump.fun sniper colony · by GrokBot
#  Copy to .env and fill in. Never commit your .env.
# ─────────────────────────────────────────────────────────────

# replay = offline simulation (no network, no money)
# paper  = real pump.fun feed + real rugcheck, fake fills (no money)
# live   = real trades. Requires LIVE_CONFIRM=I_UNDERSTAND_THE_RISK
WIDOW_MODE=paper

# ── wallet & RPC (live mode only) ────────────────────────────
# Base58 secret key of a FRESH burner wallet. Fund it with what you can lose.
WALLET_PRIVATE_KEY=
# Use a private RPC (Helius / QuickNode / Triton…). Public RPC will drop txs.
RPC_URL=https://api.mainnet-beta.solana.com
LIVE_CONFIRM=

# ── the brain ────────────────────────────────────────────────
MAX_FLAGS=1            # if risk.flags > MAX_FLAGS → cut_thread()
EDGE_MIN=0.74          # if edge > EDGE_MIN → snipe()
SIZE_SOL=0.1           # SOL per snipe (start tiny)
TP_LADDER=2.0:50,3.5:100   # take-profit ladder  x:percent_of_bag
STOP_X=0.6             # hard stop at 0.6x of entry
MAX_HOLD_SEC=600       # time stop

# ── execution ────────────────────────────────────────────────
SLIPPAGE_PCT=15
PRIORITY_FEE_SOL=0.0005
POOL=auto              # pump | raydium | pump-amm | auto

# ── risk limits ──────────────────────────────────────────────
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS_SOL=0.3
WATCH_SEC=8            # how long the web watches a launch before deciding
